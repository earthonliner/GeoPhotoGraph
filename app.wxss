page {
  background: #f2f2f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

/* iOS 分组列表：首页与帮助页共用 */
.tap-dim {
  opacity: 0.6;
}

.link {
  font-size: 26rpx;
  color: #007aff;
}

.section {
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx 14rpx;
}

.section-title {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #6d6d72;
}

.section-foot {
  display: block;
  padding: 14rpx 32rpx 0;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8e8e93;
}

.group {
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
}

.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 发丝分隔线：从文字起始处开始，与 iOS 列表一致 */
.cell-line::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1px;
  background: rgba(60, 60, 67, 0.29);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.cell-hover {
  background: #e5e5ea;
}

.cell-label {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #1c1c1e;
}

.cell-value {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  text-align: right;
  font-size: 30rpx;
  color: #8e8e93;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chevron {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin: 0 4rpx 0 20rpx;
  border-top: 4rpx solid #c7c7cc;
  border-right: 4rpx solid #c7c7cc;
  transform: rotate(45deg);
}

.cell-tall {
  min-height: 128rpx;
}

.cell-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 22rpx 0;
}

.cell-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.cell-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8e8e93;
}
