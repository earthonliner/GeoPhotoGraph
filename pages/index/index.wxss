.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.brand {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0 36rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #111;
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a86;
  letter-spacing: 2rpx;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
}

.hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a8a86;
}

/* buttons */
.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  transition: opacity 0.2s, transform 0.2s;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #111;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.22);
}

.btn-primary[disabled] {
  background: #b9b8b3;
  color: #f1f0ec;
  box-shadow: none;
}

.btn-ghost {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #f1f0ec;
  color: #333;
  font-weight: 500;
  font-size: 26rpx;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.btn-save {
  margin-top: 8rpx;
}

/* meta */
.meta {
  margin-top: 28rpx;
}

.meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #efeeea;
}

.meta-label {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #9b9a95;
}

.meta-value {
  font-size: 26rpx;
  color: #222;
  letter-spacing: 1rpx;
}

.place-input {
  flex: 1;
  height: 44rpx;
  margin-left: 32rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #111;
}

.place-placeholder {
  color: #b9b8b3;
  font-weight: 400;
}

.place-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 0;
}

.seg {
  display: flex;
  background: #f1f0ec;
  border-radius: 28rpx;
  padding: 4rpx;
}

.seg-item {
  min-width: 110rpx;
  text-align: center;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #8a8a86;
  border-radius: 24rpx;
}

.seg-active {
  background: #fff;
  color: #111;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.link {
  font-size: 22rpx;
  color: #6f6e6a;
  text-decoration: underline;
}

/* tabs */
.tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  background: #e9e8e3;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.tab {
  flex-shrink: 0;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 34rpx;
  font-size: 26rpx;
  color: #6f6e6a;
  border-radius: 34rpx;
  transition: all 0.25s;
}

.tab-active {
  background: #fff;
  color: #111;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1);
}

/* preview */
.preview {
  position: relative;
  align-self: center;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.16);
  margin-bottom: 32rpx;
}

.poster {
  display: block;
}

.busy {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 244, 241, 0.72);
}

.busy-text {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #111;
}

.notice {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a6d3b;
  background: #f7f0e1;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
}

.zoom {
  padding-bottom: 12rpx;
}

.zoom-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

/* 离屏导出画布：不可见但必须参与渲染，因此用定位移出屏幕而不是 display:none */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 400px;
}

/* 地点搜索面板：固定在上方，避免被键盘遮挡 */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  margin: 120rpx 32rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.2);
}

.sheet-head {
  display: flex;
  align-items: center;
}

.sheet-input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  background: #f1f0ec;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.sheet-cancel {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #6f6e6a;
}

.sheet-list {
  max-height: 640rpx;
  margin-top: 16rpx;
}

.sheet-item {
  display: flex;
  flex-direction: column;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #efeeea;
}

.sheet-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.sheet-addr {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a86;
  line-height: 1.5;
}

.sheet-tip {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9b9a95;
}

/* 地图配色 */
.swatches {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-top: 24rpx;
}

.swatch-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.swatch {
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
}

.swatch-active {
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 3rpx #111, 0 8rpx 20rpx rgba(0, 0, 0, 0.18);
  transform: scale(1.04);
}

.swatch-custom {
  border-style: dashed;
  border-color: #9b9a95;
}

.swatch-plus {
  font-size: 36rpx;
  color: #6f6e6a;
  line-height: 1;
}

.swatch-name {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #9b9a95;
}

.swatch-name-active {
  color: #111;
  font-weight: 600;
}

.custom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #efeeea;
}

.custom-input {
  flex: 1;
  height: 56rpx;
  margin-left: 32rpx;
  text-align: right;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  color: #111;
}

/* 不透明度 */
.op-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.op-name {
  width: 72rpx;
  font-size: 24rpx;
  color: #6f6e6a;
}

.op-slider {
  flex: 1;
  margin: 12rpx 16rpx;
}

.op-value {
  width: 88rpx;
  text-align: right;
  font-size: 22rpx;
  color: #222;
}

.crop-tip {
  margin: 12rpx 0 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a8a86;
}

/* 日期 */
.date-value {
  display: flex;
  align-items: baseline;
}

.date-edit {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #9b9a95;
  text-decoration: underline;
}

/* 调色盘 */
.picker {
  margin-top: 24rpx;
}

.pad {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  background-image: linear-gradient(to top, #000, rgba(0, 0, 0, 0)), linear-gradient(to right, #fff, rgba(255, 255, 255, 0));
}

.pad-cursor {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  margin: -18rpx 0 0 -18rpx;
  box-sizing: border-box;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.hue {
  position: relative;
  width: 100%;
  height: 40rpx;
  margin-top: 28rpx;
  border-radius: 20rpx;
  background-image: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
}

.hue-cursor {
  position: absolute;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin: -22rpx 0 0 -22rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.3), 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

/* batch */
.batch-links {
  display: flex;
  gap: 32rpx;
}

.thumbs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-top: 20rpx;
}

.thumb {
  position: relative;
  flex: none;
  width: 132rpx;
  height: 176rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 4rpx solid transparent;
  background: #e9e8e3;
}

.thumb-current {
  border-color: #111;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-check {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid #fff;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-check-on {
  background: #111;
}

.thumb-tick {
  font-size: 20rpx;
  line-height: 1;
  color: #fff;
}

.thumb-remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.thumb-warn {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  margin-top: -18rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 36rpx;
  color: #fff;
  background: rgba(190, 60, 40, 0.85);
}

.thumb-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 18rpx;
  line-height: 32rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
}

.batch-tip {
  margin-top: 16rpx;
}

.save-row {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.btn-half {
  flex: 1;
  margin-top: 16rpx;
  width: auto;
}

.btn-half[disabled] {
  opacity: 0.5;
}

.link-group {
  display: flex;
  gap: 32rpx;
}
