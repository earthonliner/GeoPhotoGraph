/* ------------------------------------------------------------------ */
/* 版式：iOS 分组列表风格。32rpx 页边距，分组圆角 20rpx，发丝分隔线         */
/* ------------------------------------------------------------------ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  /* 为底部固定工具栏留出空间 */
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.ph {
  color: #c7c7cc;
  font-weight: 400;
}

/* 大标题 */
.header {
  padding: 8rpx 0 28rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-logo {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.large-title {
  font-size: 60rpx;
  line-height: 82rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #1c1c1e;
}

.header-sub {
  display: block;
  margin: 4rpx 0 8rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8e8e93;
}

.header-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(118, 118, 128, 0.12);
}

.capsule {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #007aff;
  background: rgba(118, 118, 128, 0.12);
}

.capsule-dark {
  color: #fff;
  background: #1c1c1e;
}

/* 预览上方的模板栏：分类分段控件 + 模板标签 */
.tpl-bar {
  margin-bottom: 32rpx;
}

.tpl-bar .seg {
  margin-bottom: 20rpx;
}

/* 预览 */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-frame {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05), 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}

.poster {
  display: block;
}

.poster-cover {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
}

.busy {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(242, 242, 247, 0.78);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 5rpx solid rgba(60, 60, 67, 0.16);
  border-top-color: #3c3c43;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.busy-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #3c3c43;
}

.stage-note {
  display: block;
  margin-top: 24rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8e8e93;
  text-align: center;
}

.stage-link {
  margin-left: 12rpx;
  font-size: 24rpx;
}

.stage-warn {
  margin-top: 12rpx;
  color: #c93400;
}

/* 分组（基础的分组列表样式在 app.wxss） */
.section-action {
  font-size: 28rpx;
  line-height: 36rpx;
  color: #007aff;
}

.section-meta {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8e8e93;
  letter-spacing: 1rpx;
}

.section-links {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 32rpx 0;
}

.section-links .link {
  margin-right: 40rpx;
  line-height: 40rpx;
}

.cell-label-short {
  width: 72rpx;
}

.cell-value-tint {
  color: #007aff;
}

.cell-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin-left: 24rpx;
  text-align: right;
  font-size: 32rpx;
  color: #1c1c1e;
}

.cell-input-left {
  margin-left: 0;
  text-align: left;
}

.cell-input-hex {
  letter-spacing: 2rpx;
}

.cell-slider {
  flex: 1;
  margin: 0 32rpx 0 40rpx;
}

.cell-num {
  flex-shrink: 0;
  width: 88rpx;
  text-align: right;
  font-size: 28rpx;
  color: #8e8e93;
  font-variant-numeric: tabular-nums;
}

.cell-switch {
  margin-left: auto;
}

/* 内置 switch 自带 5px 右外边距，去掉后与其他行的右侧内容对齐 */
.cell-switch .wx-switch-input {
  margin-right: 0;
}

/* iOS 紧凑型日期选择器样式 */
.pill {
  margin-left: auto;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #1c1c1e;
  background: rgba(118, 118, 128, 0.12);
  letter-spacing: 0.5rpx;
}

/* 分段控件 */
.seg {
  display: flex;
  padding: 4rpx;
  border-radius: 18rpx;
  background: rgba(118, 118, 128, 0.12);
}

.seg-item {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1c1c1e;
  white-space: nowrap;
  transition: background-color 0.2s;
}

.seg-on {
  font-weight: 600;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12), 0 6rpx 2rpx rgba(0, 0, 0, 0.04);
}

.seg-mini {
  margin-left: auto;
}

.seg-mini .seg-item {
  flex: none;
  width: 124rpx;
  padding: 0;
}

.seg-mode {
  width: 400rpx;
}

/* 横向滚动条带。scroll-view 的 padding 会缩小内部滚动区域并裁掉阴影，留白一律放在子项上 */
.strip,
.chips {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

/* 条带铺满屏宽，首尾各留一个页边距。scroll-into-view 指向每项前面的零宽锚点：
   锚点在该项左侧一个页边距处，自动滚动后该项与页边距对齐，而不是贴住屏幕边缘 */
.bleed {
  width: calc(100% + 64rpx);
  margin-left: -32rpx;
}

.bleed-pad {
  flex-shrink: 0;
  width: 32rpx;
}

.bleed-anchor {
  flex-shrink: 0;
  width: 0;
  margin-left: -32rpx;
  margin-right: 32rpx;
}

/* 每项自带 16rpx 右外边距，补足一个页边距 */
.bleed-end {
  flex-shrink: 0;
  width: 16rpx;
}

.chip {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  background: #fff;
}

.chip-on {
  font-weight: 600;
  color: #fff;
  background: #1c1c1e;
}

/* 照片缩略图 */
.thumb {
  position: relative;
  flex-shrink: 0;
  width: 120rpx;
  height: 160rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #e5e5ea;
}

.thumb-img {
  display: block;
  width: 100%;
  height: 100%;
}

.thumb-current::after {
  content: '';
  pointer-events: none;
  z-index: 1;
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  border: 4rpx solid #1c1c1e;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 3rpx #fff;
}

.thumb-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 8rpx 8rpx;
  text-align: center;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}

.thumb-tpl {
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 600;
  color: #fff;
}

.thumb-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  transform: translate(-50%, -50%);
  white-space: nowrap;
}

.thumb-badge-warn {
  background: #ff9500;
}

/* 勾选 / 删除：可见图形小，点击热区放大 */
.thumb-hit {
  position: absolute;
  top: 0;
  z-index: 2;
  width: 60rpx;
  height: 60rpx;
}

.thumb-hit-left {
  left: 0;
}

.thumb-hit-right {
  right: 0;
}

.check {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: rgba(0, 0, 0, 0.2);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.25);
}

.check-on {
  background: #007aff;
}

.check-on::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 8rpx;
  height: 16rpx;
  border-right: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
}

.remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
}

.remove::before,
.remove::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 16rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #fff;
  transform: rotate(45deg);
}

.remove::after {
  transform: rotate(-45deg);
}

.thumb-add {
  background: rgba(118, 118, 128, 0.12);
}

.plus {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
}

.plus::before,
.plus::after {
  content: '';
  position: absolute;
  border-radius: 2rpx;
  background: #007aff;
}

.plus::before {
  left: 0;
  top: 18rpx;
  width: 40rpx;
  height: 4rpx;
}

.plus::after {
  left: 18rpx;
  top: 0;
  width: 4rpx;
  height: 40rpx;
}

.strip-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

/* 地图配色 */
.swatches {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
}

.swatch-pad {
  flex-shrink: 0;
  width: 10rpx;
}

.swatch-item {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 108rpx;
  padding: 28rpx 0 22rpx;
}

.swatch {
  width: 64rpx;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.swatch-on {
  box-shadow: 0 0 0 5rpx #fff, 0 0 0 9rpx #1c1c1e;
}

.swatch-custom {
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: linear-gradient(135deg, #ff5e5e, #ffd35e, #5ee07a, #5ec8ff, #9a7bff, #ff6fd0);
  background: conic-gradient(#ff5e5e, #ffd35e, #5ee07a, #5ec8ff, #9a7bff, #ff6fd0, #ff5e5e);
}

.swatch-core {
  width: 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

.swatch-name {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8e8e93;
}

.swatch-name-on {
  font-weight: 600;
  color: #1c1c1e;
}

/* 调色盘 */
.color-picker {
  position: relative;
  padding: 28rpx 32rpx 32rpx;
}

.pad {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background-image: linear-gradient(to top, #000, rgba(0, 0, 0, 0)), linear-gradient(to right, #fff, rgba(255, 255, 255, 0));
}

.pad-cursor {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  margin: -18rpx 0 0 -18rpx;
  box-sizing: border-box;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.3), 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.hue {
  position: relative;
  width: 100%;
  height: 36rpx;
  margin-top: 36rpx;
  border-radius: 18rpx;
  background-image: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
}

.hue-cursor {
  position: absolute;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin: -22rpx 0 0 -22rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.25), 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

/* 底部工具栏 */
.toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(249, 249, 249, 0.94);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
}

.toolbar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1px;
  background: rgba(60, 60, 67, 0.29);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}

.btn-gap {
  margin-left: 20rpx;
}

.btn-primary {
  color: #fff;
  background: #007aff;
}

.btn-secondary {
  color: #007aff;
  background: rgba(118, 118, 128, 0.12);
}

.btn-off {
  opacity: 0.4;
}

/* 底部弹出面板 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.35);
  animation: fade-in 0.2s ease-out;
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #f2f2f7;
  animation: sheet-up 0.32s cubic-bezier(0.2, 0.9, 0.3, 1);
}

.grabber {
  flex-shrink: 0;
  width: 72rpx;
  height: 10rpx;
  margin: 12rpx auto 0;
  border-radius: 5rpx;
  background: rgba(60, 60, 67, 0.3);
}

.sheet-nav {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 88rpx;
}

.sheet-side {
  width: 120rpx;
  font-size: 32rpx;
  color: #007aff;
}

.sheet-close {
  text-align: right;
}

.sheet-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.sheet-body {
  flex: 1;
  min-height: 0;
}

.pw-status-row {
  display: flex;
  justify-content: center;
  padding: 4rpx 0 28rpx;
}

.pw-status {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #3c3c43;
  background: rgba(118, 118, 128, 0.12);
}

.pw-status-on {
  color: #fff;
  background: #1c1c1e;
}

.pw-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #8a4b00;
  background: #fff4e0;
}

.pw-packs {
  padding: 0 32rpx 20rpx;
}

.pw-pack {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #6d6d72;
}

.cell-title-row {
  display: flex;
  align-items: center;
}

.plan-tag {
  margin-left: 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #6d6d72;
  background: rgba(118, 118, 128, 0.12);
}

.plan-tag-best {
  color: #007aff;
  background: rgba(0, 122, 255, 0.12);
}

.pw-unavailable {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  line-height: 44rpx;
  color: #3c3c43;
}

/* App Store 式价格按钮 */
.price {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #007aff;
  background: rgba(118, 118, 128, 0.12);
}

.pw-invite {
  margin-top: 40rpx;
}

.pw-error {
  color: #ff3b30;
}

/* 地点搜索：大尺寸面板，顶部对齐，避免被键盘遮挡 */
.sheet-search {
  top: 24rpx;
  max-height: none;
  padding: 0;
  background: #fff;
}

.search-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 16rpx;
}

.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: rgba(118, 118, 128, 0.12);
}

.search-icon {
  position: relative;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin: -4rpx 18rpx 0 2rpx;
  box-sizing: border-box;
  border: 4rpx solid #8e8e93;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  width: 4rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: #8e8e93;
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 32rpx;
  color: #1c1c1e;
}

.search-cancel {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 32rpx;
  color: #007aff;
}

.search-list {
  flex: 1;
  height: 0;
}

.result {
  position: relative;
  padding: 22rpx 32rpx;
}

.result-name {
  display: block;
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1c1c1e;
}

.result-addr {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8e8e93;
}

.search-tip {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8e8e93;
}

/* 离屏导出画布：不可见但必须参与渲染，因此用定位移出屏幕而不是 display:none */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 400px;
