<view class="page">
  <view class="brand">
    <text class="brand-name">GEOPICS</text>
    <text class="brand-sub">把照片与它发生的地方，做成一张海报</text>
  </view>

  <view class="card">
    <button class="btn btn-primary" hover-class="btn-hover" bindtap="onChoosePhoto">
      {{hasPhoto ? '重新选择照片' : '选择原图照片'}}
    </button>

    <view wx:if="{{hasPhoto}}" class="meta">
      <view class="meta-row">
        <text class="meta-label">PLACE</text>
        <input
          class="place-input"
          value="{{place}}"
          maxlength="32"
          placeholder="输入地名"
          placeholder-class="place-placeholder"
          confirm-type="done"
          bindinput="onPlaceInput"
        />
      </view>
      <view class="place-tools">
        <view class="seg">
          <view class="seg-item {{placeLang === 'en' ? 'seg-active' : ''}}" data-lang="en" bindtap="onPlaceLangChange">English</view>
          <view class="seg-item {{placeLang === 'zh' ? 'seg-active' : ''}}" data-lang="zh" bindtap="onPlaceLangChange">中文</view>
        </view>
        <text wx:if="{{placeManual}}" class="link" bindtap="onPlaceReset">恢复自动地名</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">COORD</text>
        <text class="meta-value">{{hasLocation ? coordText : '未获取位置'}}</text>
      </view>
      <picker mode="date" value="{{dateValue}}" start="1900-01-01" end="{{dateToday}}" bindchange="onDateChange">
        <view class="meta-row">
          <text class="meta-label">DATE</text>
          <view class="date-value">
            <text class="meta-value">{{dateText || '—'}}</text>
            <text class="date-edit">修改</text>
          </view>
        </view>
      </picker>
      <view wx:if="{{dateManual}}" class="place-tools">
        <text></text>
        <text class="link" bindtap="onDateReset">恢复拍摄日期</text>
      </view>
      <button class="btn btn-ghost" hover-class="btn-hover" bindtap="onPickLocation">
        {{hasLocation ? '修改位置' : '手动选择位置'}}
      </button>
    </view>

    <view wx:else class="hint">请选择带定位信息的原图（相册），将自动读取拍摄地点与日期</view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{templates}}"
      wx:key="id"
      class="tab {{item.id === templateId ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapTemplate"
    >{{item.name}}</view>
  </view>

  <view class="preview">
    <canvas
      id="posterCanvas"
      type="2d"
      class="poster"
      style="{{canvasStyle}}"
      bindtouchstart="onCanvasTouchStart"
      bindtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
      bindtouchcancel="onCanvasTouchEnd"
    ></canvas>
    <view wx:if="{{busy}}" class="busy" style="{{canvasStyle}}">
      <text class="busy-text">{{busyText}}</text>
    </view>
  </view>

  <view wx:if="{{tokenMissing}}" class="notice">
    未配置 Mapbox Token（utils/config.js），当前使用本地简约底图，地名不可用。
  </view>

  <view class="zoom card">
    <view class="zoom-head">
      <text class="meta-label">MAP ZOOM</text>
      <text class="meta-value">{{zoom}}</text>
    </view>
    <slider
      min="4"
      max="16"
      step="1"
      value="{{zoom}}"
      block-size="18"
      activeColor="#111111"
      backgroundColor="#dcdad5"
      bindchanging="onZoomChanging"
      bindchange="onZoomChange"
    />
  </view>

  <view wx:if="{{cropEnabled}}" class="card">
    <view class="zoom-head">
      <text class="meta-label">PHOTO CROP</text>
      <text class="link" bindtap="onResetCrop">重置</text>
    </view>
    <view class="crop-tip">在预览图的照片区域拖动可平移，双指可缩放；也可用下方滑块微调</view>
    <view class="op-row">
      <text class="op-name">缩放</text>
      <slider class="op-slider" min="100" max="400" step="1" value="{{cropZoom}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="cropZoom" bindchanging="onCropSlider" bindchange="onCropSlider" />
      <text class="op-value">{{cropZoom}}%</text>
    </view>
    <view class="op-row">
      <text class="op-name">左右</text>
      <slider class="op-slider" min="-100" max="100" step="1" value="{{cropX}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="cropX" bindchanging="onCropSlider" bindchange="onCropSlider" />
      <text class="op-value">{{cropX}}</text>
    </view>
    <view class="op-row">
      <text class="op-name">上下</text>
      <slider class="op-slider" min="-100" max="100" step="1" value="{{cropY}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="cropY" bindchanging="onCropSlider" bindchange="onCropSlider" />
      <text class="op-value">{{cropY}}</text>
    </view>
  </view>

  <view class="card">
    <view class="zoom-head">
      <text class="meta-label">MAP COLOR</text>
      <text class="meta-value">{{mapColorId === 'custom' ? customHex : ''}}</text>
    </view>
    <scroll-view scroll-x enable-flex class="swatches">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="swatch-item"
        data-id="{{item.id}}"
        bindtap="onTapTheme"
      >
        <view class="swatch {{item.id === mapColorId ? 'swatch-active' : ''}} {{item.id === 'custom' ? 'swatch-custom' : ''}}" style="background:{{item.tint}};">
          <text wx:if="{{item.id === 'custom'}}" class="swatch-plus">+</text>
        </view>
        <text class="swatch-name {{item.id === mapColorId ? 'swatch-name-active' : ''}}">{{item.name}}</text>
      </view>
    </scroll-view>
    <view wx:if="{{mapColorId === 'custom'}}" class="picker">
      <view id="colorPad" class="pad" style="background-color:{{hueColor}};" bindtouchstart="onPadStart" catchtouchmove="onPadMove">
        <view class="pad-cursor" style="{{padCursor}}"></view>
      </view>
      <view id="hueBar" class="hue" bindtouchstart="onHueStart" catchtouchmove="onHueMove">
        <view class="hue-cursor" style="{{hueCursor}}background:{{hueColor}};"></view>
      </view>
    </view>
    <view wx:if="{{mapColorId === 'custom'}}" class="custom-row">
      <text class="meta-label">HEX</text>
      <input
        class="custom-input"
        value="{{customHexText}}"
        maxlength="7"
        placeholder="#E8DFD0"
        placeholder-class="place-placeholder"
        bindinput="onCustomHexInput"
      />
    </view>
  </view>

  <view class="card">
    <view class="zoom-head">
      <text class="meta-label">OPACITY</text>
      <text class="link" bindtap="onResetOpacity">重置</text>
    </view>
    <view class="op-row">
      <text class="op-name">地图</text>
      <slider class="op-slider" min="0" max="100" step="1" value="{{mapOpacity}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="mapOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
      <text class="op-value">{{mapOpacity}}%</text>
    </view>
    <view class="op-row">
      <text class="op-name">照片</text>
      <slider class="op-slider" min="0" max="100" step="1" value="{{photoOpacity}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="photoOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
      <text class="op-value">{{photoOpacity}}%</text>
    </view>
    <view class="op-row">
      <text class="op-name">文字</text>
      <slider class="op-slider" min="0" max="100" step="1" value="{{textOpacity}}" block-size="16" activeColor="#111111" backgroundColor="#dcdad5" data-key="textOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
      <text class="op-value">{{textOpacity}}%</text>
    </view>
  </view>

  <button class="btn btn-primary btn-save" hover-class="btn-hover" disabled="{{!hasPhoto || busy}}" bindtap="onSavePoster">
    保存高清海报
  </button>

  <view wx:if="{{searchVisible}}" class="sheet-mask" bindtap="onSearchClose">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <input
          class="sheet-input"
          focus
          value="{{searchKeyword}}"
          placeholder="搜索城市、地标、地址（全球）"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <text class="sheet-cancel" bindtap="onSearchClose">取消</text>
      </view>
      <scroll-view scroll-y class="sheet-list">
        <view
          wx:for="{{searchResults}}"
          wx:key="address"
          class="sheet-item"
          data-index="{{index}}"
          bindtap="onSelectResult"
        >
          <text class="sheet-name">{{item.name}}</text>
          <text class="sheet-addr">{{item.address}}</text>
        </view>
        <view wx:if="{{searching}}" class="sheet-tip">搜索中…</view>
        <view wx:elif="{{searchEmpty}}" class="sheet-tip">没有找到相关地点</view>
      </scroll-view>
    </view>
  </view>

  <!-- 离屏导出画布：移出可视区，物理尺寸在 JS 中设为 1200 x 1600 -->
  <canvas id="exportCanvas" type="2d" class="export-canvas"></canvas>
</view>
