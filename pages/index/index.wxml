<view class="page">
  <view class="header">
    <view class="header-row">
      <view class="brand">
        <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" />
        <text class="large-title">GEOPICS</text>
      </view>
      <view wx:if="{{!singlePage}}" class="header-actions">
        <text class="icon-btn" hover-class="tap-dim" aria-label="帮助与关于" bindtap="onOpenAbout">?</text>
        <view class="capsule {{isMember ? 'capsule-dark' : ''}}" hover-class="tap-dim" bindtap="onOpenPaywall">{{memberChip}}</view>
      </view>
    </view>
    <text wx:if="{{!hasPhoto}}" class="header-sub">把照片与它发生的地方，做成一张海报</text>
  </view>

  <view wx:if="{{hasPhoto}}" class="tpl-bar">
    <view class="seg">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="seg-item {{item.id === catId ? 'seg-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapCategory"
      >{{item.name}}</view>
    </view>
    <scroll-view scroll-x enable-flex class="chips bleed" scroll-with-animation scroll-into-view="tab-{{templateId}}">
      <view class="bleed-pad"></view>
      <block wx:for="{{visibleTemplates}}" wx:key="id">
        <view id="tab-{{item.id}}" class="bleed-anchor"></view>
        <view class="chip {{item.id === templateId ? 'chip-on' : ''}}" data-id="{{item.id}}" bindtap="onTapTemplate">{{item.name}}</view>
      </block>
      <view class="bleed-end"></view>
    </scroll-view>
  </view>

  <view class="stage">
    <view class="poster-frame" style="{{canvasStyle}}" bindtap="onTapPreview">
      <canvas
        id="posterCanvas"
        type="2d"
        class="poster"
        style="{{canvasStyle}}"
        hidden="{{previewCovered}}"
        bindtouchstart="onCanvasTouchStart"
        bindtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
      ></canvas>
      <image wx:if="{{previewCovered && coverImage}}" class="poster-cover" src="{{coverImage}}" mode="scaleToFill" style="{{canvasStyle}}" />
      <view wx:if="{{busy}}" class="busy">
        <view class="spinner"></view>
        <text wx:if="{{busyText}}" class="busy-text">{{busyText}}</text>
      </view>
    </view>
    <view wx:if="{{hasPhoto && stageNote}}" class="stage-note">
      <text>{{stageNote}}</text>
      <text wx:if="{{currentLocked && canPurchase}}" class="link stage-link" bindtap="onOpenPaywall">解锁无水印高清图</text>
    </view>
    <text wx:if="{{singlePage}}" class="stage-note">当前为朋友圈预览，点击下方「前往小程序」即可用自己的照片制作</text>
    <text wx:elif="{{!hasPhoto}}" class="stage-note">选择照片，自动读取拍摄日期与地点；读不到地点时，选择一次即可</text>
    <text wx:if="{{tokenMissing}}" class="stage-note stage-warn">开发提示：未配置 Mapbox Token（utils/config.local.js），当前使用本地简约底图，地名不可用</text>
  </view>

  <block wx:if="{{hasPhoto}}">
    <view class="section">
      <view class="section-head">
        <text class="section-title">照片 {{itemCount}}/{{maxBatch}}</text>
        <text wx:if="{{itemCount > 1}}" class="section-action" bindtap="onToggleSelectAll">{{selectedCount === itemCount ? '取消全选' : '全选'}}</text>
      </view>
      <scroll-view scroll-x enable-flex class="strip bleed" scroll-with-animation scroll-into-view="thumb-{{currentId}}">
        <view class="bleed-pad"></view>
        <block wx:for="{{list}}" wx:key="id">
          <view id="thumb-{{item.id}}" class="bleed-anchor"></view>
          <view class="thumb {{item.current ? 'thumb-current' : ''}}" data-id="{{item.id}}" bindtap="onTapItem">
            <image class="thumb-img" src="{{item.path}}" mode="aspectFill" />
            <view wx:if="{{batchMode === 'random' && itemCount > 1}}" class="thumb-scrim">
              <text class="thumb-tpl">{{item.tplName}}</text>
            </view>
            <text wx:if="{{item.noLoc}}" class="thumb-badge thumb-badge-warn">无位置</text>
            <text wx:elif="{{item.locked && lockBadges}}" class="thumb-badge">水印</text>
            <view wx:if="{{itemCount > 1}}" class="thumb-hit thumb-hit-left" data-id="{{item.id}}" catchtap="onToggleSelect">
              <view class="check {{item.selected ? 'check-on' : ''}}"></view>
            </view>
            <view wx:if="{{item.current}}" class="thumb-hit thumb-hit-right" data-id="{{item.id}}" catchtap="onRemoveItem">
              <view class="remove"></view>
            </view>
          </view>
        </block>
        <view class="thumb thumb-add" hover-class="tap-dim" bindtap="onTapAddTile">
          <view class="plus"></view>
        </view>
        <view class="bleed-end"></view>
      </scroll-view>
      <view wx:if="{{itemCount > 1}}" class="strip-tools">
        <view class="seg seg-mode">
          <view class="seg-item {{batchMode === 'unique' ? 'seg-on' : ''}}" data-mode="unique" bindtap="onBatchModeChange">统一模板</view>
          <view class="seg-item {{batchMode === 'random' ? 'seg-on' : ''}}" data-mode="random" bindtap="onBatchModeChange">随机模板</view>
        </view>
        <text wx:if="{{batchMode === 'random'}}" class="link" bindtap="onReshuffle">重新随机</text>
      </view>
      <text wx:if="{{itemCount === 1 && batchOk}}" class="section-foot">点按 + 可继续添加，最多 {{maxBatch}} 张，一次生成多张海报。</text>
      <text wx:elif="{{itemCount === 1}}" class="section-foot">{{canPurchase ? '批量导入与批量下载为会员功能：月度、年度、买断会员和邀请码可用，单张解锁不含批量。' : '批量导入与批量下载为会员功能。'}}<text class="link" bindtap="onOpenPaywall">{{canPurchase ? '查看会员权益' : '会员与额度'}}</text></text>
      <text wx:elif="{{batchMode === 'unique'}}" class="section-foot">所有照片使用同一模板。点按缩略图编辑单张，左上角勾选的照片用于批量下载。</text>
      <text wx:else class="section-foot">每张照片在当前分类内随机分配模板，点按缩略图可单独更换。左上角勾选的照片用于批量下载。</text>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">地点与日期</text>
      </view>
      <view class="group">
        <view class="cell">
          <text class="cell-label">地点</text>
          <input
            class="cell-input"
            value="{{place}}"
            maxlength="32"
            placeholder="输入地名"
            placeholder-class="ph"
            confirm-type="done"
            bindinput="onPlaceInput"
          />
        </view>
        <picker mode="date" value="{{dateValue}}" start="1900-01-01" end="{{dateToday}}" bindchange="onDateChange">
          <view class="cell cell-line" hover-class="cell-hover">
            <text class="cell-label">日期</text>
            <text class="pill">{{dateText || '选择日期'}}</text>
          </view>
        </picker>
        <view class="cell cell-line" hover-class="cell-hover" bindtap="onPickLocation">
          <text class="cell-label">坐标</text>
          <text class="cell-value {{hasLocation ? '' : 'cell-value-tint'}}">{{hasLocation ? coordText : '选择位置'}}</text>
          <view class="chevron"></view>
        </view>
        <view class="cell cell-line">
          <text class="cell-label">地名语言</text>
          <view class="seg seg-mini">
            <view class="seg-item {{placeLang === 'en' ? 'seg-on' : ''}}" data-lang="en" bindtap="onPlaceLangChange">English</view>
            <view class="seg-item {{placeLang === 'zh' ? 'seg-on' : ''}}" data-lang="zh" bindtap="onPlaceLangChange">中文</view>
          </view>
        </view>
        <view class="cell cell-line">
          <text class="cell-label">地名范围</text>
          <view class="seg seg-mini">
            <view class="seg-item {{placeLevel === 'city' ? 'seg-on' : ''}}" data-level="city" bindtap="onPlaceLevelChange">城市</view>
            <view class="seg-item {{placeLevel === 'detail' ? 'seg-on' : ''}}" data-level="detail" bindtap="onPlaceLevelChange">含区域</view>
          </view>
        </view>
      </view>
      <view wx:if="{{itemCount > 1 || placeManual || dateManual}}" class="section-links">
        <text wx:if="{{itemCount > 1}}" class="link" bindtap="onApplyToAllMenu">应用到全部照片</text>
        <text wx:if="{{placeManual}}" class="link" bindtap="onPlaceReset">恢复自动地名</text>
        <text wx:if="{{dateManual}}" class="link" bindtap="onDateReset">恢复拍摄日期</text>
      </view>
    </view>

    <view wx:if="{{cropEnabled}}" class="section">
      <view class="section-head">
        <text class="section-title">照片取景</text>
        <text class="section-action" bindtap="onResetCrop">重置</text>
      </view>
      <view class="group">
        <view class="cell">
          <text class="cell-label cell-label-short">缩放</text>
          <slider class="cell-slider" min="100" max="400" step="1" value="{{cropZoom}}" block-size="24" activeColor="#007AFF" backgroundColor="#E5E5EA" data-key="cropZoom" bindchanging="onCropSlider" bindchange="onCropSlider" />
          <text class="cell-num">{{cropZoom}}%</text>
        </view>
        <view class="cell cell-line">
          <text class="cell-label cell-label-short">左右</text>
          <slider class="cell-slider" min="-100" max="100" step="1" value="{{cropX}}" block-size="24" activeColor="#E5E5EA" backgroundColor="#E5E5EA" data-key="cropX" bindchanging="onCropSlider" bindchange="onCropSlider" />
          <text class="cell-num">{{cropX}}</text>
        </view>
        <view class="cell cell-line">
          <text class="cell-label cell-label-short">上下</text>
          <slider class="cell-slider" min="-100" max="100" step="1" value="{{cropY}}" block-size="24" activeColor="#E5E5EA" backgroundColor="#E5E5EA" data-key="cropY" bindchanging="onCropSlider" bindchange="onCropSlider" />
          <text class="cell-num">{{cropY}}</text>
        </view>
      </view>
      <text class="section-foot">也可以直接在预览图的照片区域拖动平移、双指缩放。</text>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">地图</text>
        <text wx:if="{{mapColorId === 'custom'}}" class="section-meta">{{customHex}}</text>
      </view>
      <view class="group">
        <scroll-view scroll-x enable-flex class="swatches">
          <view class="swatch-pad"></view>
          <view
            wx:for="{{themes}}"
            wx:key="id"
            class="swatch-item"
            data-id="{{item.id}}"
            bindtap="onTapTheme"
          >
            <view
              class="swatch {{item.id === mapColorId ? 'swatch-on' : ''}} {{item.id === 'custom' ? 'swatch-custom' : ''}}"
              style="{{item.id === 'custom' ? '' : 'background:' + item.tint + ';'}}"
            >
              <view wx:if="{{item.id === 'custom'}}" class="swatch-core" style="background:{{item.tint}};"></view>
            </view>
            <text class="swatch-name {{item.id === mapColorId ? 'swatch-name-on' : ''}}">{{item.name}}</text>
          </view>
          <view class="swatch-pad"></view>
        </scroll-view>
        <view wx:if="{{mapColorId === 'custom'}}" class="color-picker cell-line">
          <view id="colorPad" class="pad" style="background-color:{{hueColor}};" bindtouchstart="onPadStart" catchtouchmove="onPadMove">
            <view class="pad-cursor" style="{{padCursor}}"></view>
          </view>
          <view id="hueBar" class="hue" bindtouchstart="onHueStart" catchtouchmove="onHueMove">
            <view class="hue-cursor" style="{{hueCursor}}background:{{hueColor}};"></view>
          </view>
        </view>
        <view wx:if="{{mapColorId === 'custom'}}" class="cell cell-line">
          <text class="cell-label">色值</text>
          <input
            class="cell-input cell-input-hex"
            value="{{customHexText}}"
            maxlength="7"
            placeholder="#E8DFD0"
            placeholder-class="ph"
            bindinput="onCustomHexInput"
          />
        </view>
        <view class="cell cell-line">
          <text class="cell-label cell-label-short">缩放</text>
          <slider class="cell-slider" min="4" max="16" step="1" value="{{zoom}}" block-size="24" activeColor="#007AFF" backgroundColor="#E5E5EA" bindchanging="onZoomChanging" bindchange="onZoomChange" />
          <text class="cell-num">{{zoom}}</text>
        </view>
      </view>
      <text class="section-foot">缩放级别越大，地图越接近街道细节。</text>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">不透明度</text>
        <text class="section-action" bindtap="onResetOpacity">重置</text>
      </view>
      <view class="group">
        <view class="cell">
          <text class="cell-label cell-label-short">地图</text>
          <slider class="cell-slider" min="0" max="100" step="1" value="{{mapOpacity}}" block-size="24" activeColor="#007AFF" backgroundColor="#E5E5EA" data-key="mapOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
          <text class="cell-num">{{mapOpacity}}%</text>
        </view>
        <view class="cell cell-line">
          <text class="cell-label cell-label-short">照片</text>
          <slider class="cell-slider" min="0" max="100" step="1" value="{{photoOpacity}}" block-size="24" activeColor="#007AFF" backgroundColor="#E5E5EA" data-key="photoOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
          <text class="cell-num">{{photoOpacity}}%</text>
        </view>
        <view class="cell cell-line">
          <text class="cell-label cell-label-short">文字</text>
          <slider class="cell-slider" min="0" max="100" step="1" value="{{textOpacity}}" block-size="24" activeColor="#007AFF" backgroundColor="#E5E5EA" data-key="textOpacity" bindchanging="onOpacityChanging" bindchange="onOpacityChange" />
          <text class="cell-num">{{textOpacity}}%</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">海报</text>
      </view>
      <view class="group">
        <view class="cell">
          <text class="cell-label">品牌底栏</text>
          <switch class="cell-switch" checked="{{footerOn}}" color="#34C759" bindchange="onToggleFooter" />
        </view>
        <view class="cell cell-line">
          <text class="cell-label">导出尺寸</text>
          <text class="cell-value">{{exportSize}} px</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!singlePage}}" class="toolbar">
    <view wx:if="{{!hasPhoto}}" class="btn btn-primary {{busy ? 'btn-off' : ''}}" hover-class="tap-dim" bindtap="onChoosePhoto">从相册选择照片</view>
    <block wx:elif="{{itemCount > 1}}">
      <view class="btn btn-secondary {{busy ? 'btn-off' : ''}}" hover-class="tap-dim" bindtap="onSavePoster">{{currentLocked ? '解锁后保存' : '保存当前'}}</view>
      <view class="btn btn-primary btn-gap {{busy || selectedCount === 0 ? 'btn-off' : ''}}" hover-class="tap-dim" bindtap="onSaveBatch">{{!batchOk ? '批量下载 · 会员' : selectedCount === itemCount ? '下载全部 ' + itemCount + ' 张' : '下载所选 ' + selectedCount + ' 张'}}</view>
    </block>
    <view wx:else class="btn btn-primary {{busy ? 'btn-off' : ''}}" hover-class="tap-dim" bindtap="onSavePoster">{{currentLocked ? '解锁后保存' : '保存高清海报'}}</view>
  </view>

  <view wx:if="{{paywallVisible}}" class="mask" bindtap="onPaywallClose">
    <view class="sheet" catchtap="noop">
      <view class="grabber"></view>
      <view class="sheet-nav">
        <text class="sheet-side"></text>
        <text class="sheet-title">{{canPurchase ? '解锁无水印高清图' : '会员与额度'}}</text>
        <text class="sheet-side sheet-close" bindtap="onPaywallClose">关闭</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view class="pw-status-row">
          <text class="pw-status {{isMember ? 'pw-status-on' : ''}}">{{memberLabel}}</text>
        </view>
        <view wx:if="{{paywallNotice}}" class="pw-notice">{{paywallNotice}}</view>
        <view wx:if="{{packLines.length}}" class="pw-packs">
          <text wx:for="{{packLines}}" wx:key="*this" class="pw-pack">{{item}}</text>
        </view>

        <block wx:if="{{canPurchase}}">
          <view class="group">
            <view
              wx:for="{{plans}}"
              wx:key="id"
              class="cell cell-tall {{index > 0 ? 'cell-line' : ''}}"
              hover-class="cell-hover"
              data-kind="{{item.kind}}"
              data-id="{{item.id}}"
              bindtap="onBuy"
            >
              <view class="cell-main">
                <view class="cell-title-row">
                  <text class="cell-title">{{item.name}}</text>
                  <text class="plan-tag {{item.best ? 'plan-tag-best' : ''}}">{{item.unitText}}</text>
                </view>
                <text class="cell-sub">{{item.desc}}</text>
              </view>
              <text class="price">{{item.priceText}}</text>
            </view>
            <view wx:if="{{hasPhoto}}" class="cell cell-tall cell-line" hover-class="cell-hover" data-kind="single" bindtap="onBuy">
              <view class="cell-main">
                <text class="cell-title">{{singleOffer.name}}</text>
                <text class="cell-sub">{{singleOffer.desc}}</text>
              </view>
              <text class="price">{{singleOffer.priceText}}</text>
            </view>
          </view>
          <text class="section-foot">月度、年度、买断会员开放批量导入与批量下载，买断每月额度有限、次月 1 日重置；单张解锁不含批量。解锁后可保存 {{exportSize}} 无水印高清海报，每保存一张消耗 1 个额度，同一张照片同一模板再次保存不重复计费。额度用完后，可再次购买月度或年度会员叠加使用。</text>
        </block>
        <block wx:else>
          <view class="group">
            <view class="cell cell-tall">
              <text class="pw-unavailable">{{purchaseNote}}</text>
            </view>
          </view>
          <text class="section-foot">每保存一张 {{exportSize}} 无水印高清海报消耗 1 个额度，同一张照片同一模板再次保存不重复计费。</text>
        </block>

        <view class="group pw-invite">
          <view class="cell">
            <input
              class="cell-input cell-input-left"
              value="{{inviteInput}}"
              placeholder="输入邀请码"
              placeholder-class="ph"
              confirm-type="done"
              bindinput="onInviteInput"
              bindconfirm="onRedeemInvite"
            />
            <text class="price" hover-class="tap-dim" bindtap="onRedeemInvite">兑换</text>
          </view>
        </view>
        <text wx:if="{{inviteError}}" class="section-foot pw-error">{{inviteError}}</text>
        <text wx:if="{{mockPay}}" class="section-foot">当前为测试支付模式：点击购买仅模拟支付成功，不会真实扣款。</text>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{searchVisible}}" class="mask" bindtap="onSearchClose">
    <view class="sheet sheet-search" catchtap="noop">
      <view class="grabber"></view>
      <view class="search-bar">
        <view class="search-field">
          <view class="search-icon"></view>
          <input
            class="search-input"
            focus
            value="{{searchKeyword}}"
            placeholder="搜索城市、地标、地址（全球）"
            placeholder-class="ph"
            confirm-type="search"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
          />
        </view>
        <text class="search-cancel" bindtap="onSearchClose">取消</text>
      </view>
      <scroll-view scroll-y class="search-list">
        <view
          wx:for="{{searchResults}}"
          wx:key="address"
          class="result {{index > 0 ? 'cell-line' : ''}}"
          hover-class="cell-hover"
          data-index="{{index}}"
          bindtap="onSelectResult"
        >
          <text class="result-name">{{item.name}}</text>
          <text class="result-addr">{{item.address}}</text>
        </view>
        <view wx:if="{{searching}}" class="search-tip">搜索中…</view>
        <view wx:elif="{{searchEmpty}}" class="search-tip">没有找到相关地点</view>
      </scroll-view>
    </view>
  </view>

  <!-- 离屏导出画布：移出可视区，物理尺寸在 JS 中设为 1200 x 1600 -->
  <canvas id="exportCanvas" type="2d" class="export-canvas"></canvas>
</view>
