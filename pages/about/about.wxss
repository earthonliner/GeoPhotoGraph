.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(64rpx + constant(safe-area-inset-bottom));
  padding: 0 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 8rpx;
}

/* 与 App 图标一致的圆角白底 */
.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.04);
}

.hero-logo {
  width: 100rpx;
  height: 100rpx;
}

.hero-name {
  margin-top: 28rpx;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #1c1c1e;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8e8e93;
}

.hero-version {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #aeaeb2;
}

.step {
  align-items: flex-start;
}

.step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin: 24rpx 24rpx 0 0;
  border-radius: 50%;
  text-align: center;
  font-size: 26rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #fff;
  background: #007aff;
}

/* 分隔线从编号右侧的文字处开始 */
.cell-line-indent::before {
  left: 100rpx;
}

.note-title {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.note-text {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #6d6d72;
}

.row-label {
  flex: 1;
  min-width: 0;
  padding: 22rpx 0;
  font-size: 30rpx;
  line-height: 44rpx;
  color: #1c1c1e;
}

.faq {
  position: relative;
}

.chevron-down {
  margin-top: -8rpx;
  transform: rotate(135deg);
}

.chevron-up {
  margin-top: 8rpx;
  transform: rotate(-45deg);
}

.faq-a {
  display: block;
  padding: 0 32rpx 26rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #48484a;
}

/* 重置按钮默认样式，使开放能力按钮看起来与普通列表行一致。
   基础库给 button 的宽度、外边距、内边距选择器优先级更高，这几项需要 !important */
.cell-btn {
  width: 100% !important;
  margin: 0 !important;
  padding: 0 32rpx !important;
  border-radius: 0;
  background: #fff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: normal;
  text-align: left;
  color: #1c1c1e;
}

.cell-btn::after {
  border: none;
}

.cell-btn.cell-hover {
  background: #e5e5ea;
}

.credits {
  display: block;
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #aeaeb2;
}
